# Go-Ether 项目环境变量配置示例

# 网络配置
# 可选值: local, goerli, sepolia, mainnet
NETWORK=local

# RPC URL (HTTP，用于合约调用、交易查询、Gas 估算等)
ETH_RPC_URL=http://localhost:8545

# WebSocket URL (用于事件订阅，可选，不配则事件监听不可用)
ETH_WS_URL=ws://localhost:8546

# ERC20 合约地址
ERC20_CONTRACT=0xYourContractAddressHere

# 发送者私钥 (用于签名交易)
# 注意: 生产环境中请妥善保管私钥，不要提交到版本控制
SENDER_PRIVATE_KEY=your_private_key_here